# 1단계 필수
DART_API_KEY=

# 메일 (기본: 네이버). 네이버는 SMTP_USER=네이버 아이디, MAIL_FROM=아이디@naver.com
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# 받는 주소 (비우면 MAIL_FROM으로 발송)
MAIL_TO=
# 다른 메일 서비스를 쓸 때만 (예: Gmail은 smtp.gmail.com / 465)
SMTP_HOST=
SMTP_PORT=

# 선택: KRX 정보데이터시스템 계정이 있으면 외국인·기관 수급 표시
KRX_ID=
KRX_PW=

# NH투자증권 나무 플러그 Open API (nhplug.com) — 잔고 조회용
NH_APP_KEY=
NH_APP_SECRET=

# Claude 구독 토큰 (claude setup-token) — GitHub Actions의 AI 해설용
CLAUDE_CODE_OAUTH_TOKEN=
